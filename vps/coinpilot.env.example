# Copy to vps/coinpilot.env on the VPS, fill in, then: chmod 600 vps/coinpilot.env
# All three are already supported by coinpilot/config.py (values are stripped
# of stray spaces, so mobile-paste artifacts cannot break them).
OPENAI_API_KEY=gsk_your_groq_key_here
COINPILOT_LLM_BASE_URL=https://api.groq.com/openai/v1
COINPILOT_LLM_MODEL=llama-3.3-70b-versatile
